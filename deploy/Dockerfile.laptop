# syntax=docker/dockerfile:1
# Synthetic localhost testing only. No browser/OCR/ClamAV daemon bundled.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /opt/mcias
COPY --chown=1900:1900 pyproject.toml ./
COPY --chown=1900:1900 mcias/ ./mcias/
# Optional combined CA bundle for the managed build proxy; never retained in layers.
RUN --mount=type=secret,id=proxy_ca \
    --mount=type=cache,id=mcias-laptop-pip,target=/root/.cache/pip,sharing=locked \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    install_attempt=1; \
    until python -m pip install --timeout 180 --retries 10 .; do \
        if [ "$install_attempt" -ge 3 ]; then \
            echo 'Python dependency installation failed after 3 attempts.' >&2; \
            exit 1; \
        fi; \
        install_attempt=$((install_attempt + 1)); \
        echo "Retrying Python dependency installation (attempt $install_attempt/3)." >&2; \
        sleep 10; \
    done \
    && groupadd --system --gid 1900 mcias \
    && useradd --system --uid 1900 --gid 1900 --home-dir /nonexistent --shell /usr/sbin/nologin mcias \
    && mkdir -p /var/lib/mcias/sources /var/lib/mcias/state \
    && chown -R 1900:1900 /var/lib/mcias && chmod 0700 /var/lib/mcias/sources /var/lib/mcias/state
COPY --chown=1900:1900 alembic.ini ./
COPY --chown=1900:1900 alembic/ ./alembic/
USER 1900:1900
HEALTHCHECK --interval=10s --timeout=4s --retries=12 \
    CMD python -c "from urllib.request import urlopen; assert urlopen('http://127.0.0.1:8000/health/ready',timeout=3).status==200"
CMD ["python", "-m", "uvicorn", "mcias.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
